{
  "markdown": {
    "textWrap": "always",
    "lineWidth": 120,
    "emphasisKind": "asterisks",
    "strongKind": "asterisks",
    "unorderedListKind": "dashes"
  },
  "shfmt": {
    "associations": ["**/*.sh", "scripts/winter-cli"]
  },
  "excludes": ["target/**", ".tools/**"],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.29.0.wasm",
    "https://plugins.dprint.dev/json-0.26.0.wasm",
    "https://plugins.dprint.dev/toml-0.10.0.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm",
    "https://plugins.dprint.dev/shfmt-0.2.0.wasm"
  ]
}
