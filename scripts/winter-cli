#!/usr/bin/env bash
set -euo pipefail

repo="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
channel=""
in_toolchain=false
while IFS= read -r line || [[ -n "$line" ]]; do
	if [[ "$line" =~ ^[[:space:]]*\[([^]]+)\][[:space:]]*(#.*)?$ ]]; then
		in_toolchain=false
		[[ "${BASH_REMATCH[1]}" == toolchain ]] && in_toolchain=true
	elif $in_toolchain && [[ "$line" =~ ^[[:space:]]*channel[[:space:]]*=[[:space:]]*\"([a-zA-Z0-9._-]+)\"[[:space:]]*(#.*)?$ ]]; then
		if [[ -n "$channel" ]]; then
			echo "winter-cli: duplicate toolchain channel" >&2
			exit 1
		fi
		channel="${BASH_REMATCH[1]}"
	fi
done <"$repo/rust-toolchain.toml"
if [[ -z "$channel" ]]; then
	echo "winter-cli: missing or invalid toolchain channel" >&2
	exit 1
fi
exec cargo "+$channel" run --locked --offline --manifest-path "$repo/Cargo.toml" -p winter-test-harness --bin winter-dev -- run -- "$@"
